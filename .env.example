# Voorbeeldinstellingen. Op Unraid: plak dit in de ENV File van de stack
# (Compose-pagina > stack > Edit Stack > ENV File) en vul je eigen waarden in.

# --- Scherm ---
# IP-adres van de SmallTV
DEVICE_HOST=192.168.1.50
# nummer van de Picture-app
PICTURE_THEME=4
# seconden per pagina
PAGE_SECONDS=10
# volgorde; 'updates' verschijnt alleen als er iets is
PAGES=weer,instagram,facebook,google,nieuwsbrief,website,updates
# accentkleur (hex, zonder #)
ACCENT_COLOR=FFD71B

# --- Weer (Open-Meteo + Buienradar, geen sleutel) ---
WEATHER_NAME=Plaatsnaam
WEATHER_LAT=52.0
WEATHER_LON=5.0
WEATHER_MINUTES=15
RAIN_MINUTES=5

# --- Nieuwsbrief (phpList, alleen-lezen databasegebruiker) ---
PHPLIST_DB_HOST=phplist-db
PHPLIST_DB_PORT=3306
PHPLIST_DB_NAME=phplist
PHPLIST_DB_USER=geekmagic
PHPLIST_DB_PASSWORD=
PHPLIST_TABLE_PREFIX=phplist_
PHPLIST_LIST_ID=1
NEWSLETTER_LABEL=leden nieuwsbrief
STATS_MINUTES=15

# --- Instagram + Facebook (Meta Graph API) ---
# pagina-token (verloopt niet), ID van de Facebook-pagina; Instagram-ID wordt zelf gevonden
META_PAGE_TOKEN=
META_PAGE_ID=
META_IG_ID=
META_API_VERSION=v27.0
# kleur van de pictogrammen (hex, zonder #)
INSTAGRAM_COLOR=D6338A
FACEBOOK_COLOR=3B7BF0

# --- Google-reviews (Places API New) ---
# API-sleutel beperkt tot de Places API (New); Place ID óf een zoekterm (eenmalig opgezocht)
GOOGLE_API_KEY=
GOOGLE_PLACE_ID=
GOOGLE_PLACE_QUERY=Bedrijfsnaam Plaats
# rating en aantal vallen onder Enterprise (1.000 gratis per maand): 120 min = ~370 per maand
GOOGLE_MINUTES=120

# --- Websitebezoekers (Umami) ---
# intern adres van Umami, bv. http://192.168.1.10:3000
UMAMI_URL=
UMAMI_WEBSITE_ID=
# óf een API-sleutel (Umami: Settings > API keys) óf een gebruiker
UMAMI_API_KEY=
UMAMI_USERNAME=
UMAMI_PASSWORD=

# --- Unraid-updates (API-sleutel met alleen leesrechten) ---
UNRAID_API_URL=http://192.168.1.10/graphql
UNRAID_API_KEY=
UPDATES_MINUTES=5

# --- WordPress-updates via SSH + WP-CLI ---
WP_SSH_HOST=
WP_SSH_USER=
WP_SSH_PORT=22
WP_SSH_KEY=/data/ssh/id_ed25519
# komma-gescheiden, t.o.v. de SSH-thuismap
WP_PATHS=httpdocs
# naam op het scherm per pad
WP_LABELS=httpdocs=mijnsite.nl
WORDPRESS_MINUTES=240

# --- Receptsuggesties (plugin "Kampvuurkok receptsuggesties") ---
# beide waarden staan in wp-admin > WP Recipe Maker > Receptsuggesties; tegel verschijnt alleen als er iets wacht
RECEPTEN_URL=
RECEPTEN_TOKEN=
RECEPTEN_MINUTES=15

# --- Overig ---
# poort van de statuspagina in de container (op Unraid: zie ports in docker-compose.yml)
STATUS_PORT=8080
TZ=Europe/Amsterdam
LOG_LEVEL=INFO
# 1 = niets naar het scherm, alleen preview-plaatjes in data/preview
DRY_RUN=0
